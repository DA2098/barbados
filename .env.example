# Frontend API URL
# LOCAL DEVELOPMENT
VITE_API_URL=http://localhost:3000/api

# RENDER PRODUCTION
# VITE_API_URL=https://barbados-api.onrender.com/api

# Sesion duplicada: segundos para confirmar "Seguir aqui" antes del cierre automatico.
VITE_DUPLICATE_SESSION_GRACE_SECONDS=45

# Inactividad: segundos sin actividad antes de cerrar sesion y volver al inicio.
VITE_IDLE_TIMEOUT_SECONDS=1800
