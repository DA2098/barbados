# .env.example — plantilla de variables de entorno
# ----------------------------------------------
# Copia este archivo a `.env` en el directorio `backend/` y rellena
# las claves reales. NUNCA subas `.env` al repositorio.

# DATABASE
# PostgreSQL connection string para desarrollo local
DATABASE_URL='postgresql://postgres:6x679zDDNaXTtX3RGbSwuyCTI6JmIMam@dpg-d8pv36cm0tmc73b95ccg-a.ohio-postgres.render.com:5432/barbados_s6oc';

# Para despliegues (Render, Railway, Neon), define DATABASE_URL
# DATABASE_URL=postgresql://user:password@host.databases.xxx.com:5432/dbname

# SERVER
PORT=3000
NODE_ENV=development

# FRONTEND
# URL base usada para redirecciones después del pago (sin trailing slash)
FRONTEND_URL=http://localhost:5173

# PAGOS / FACTURAS
# Moneda usada para pagos y facturas. Ej: usd
PAYMENT_CURRENCY=usd
# Porcentaje de impuesto aplicado en las facturas (ej. 0.13 = 13%)
INVOICE_TAX_RATE=0.13

# STRIPE (tarjetas)
# Usa claves de prueba en desarrollo (sk_test_..., pk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PAYPAL (Checkout)
# PAYPAL_ENV: 'sandbox' o 'live'
# En desarrollo usa 'sandbox' y las credenciales de sandbox de PayPal.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Marca y datos para las facturas (se usan en los PDFs)
BRAND_NAME=BARBADOS
BRAND_TAGLINE=Barbería salvadoreña con estilo premium
BRAND_ADDRESS=El Salvador
BRAND_PHONE=
BRAND_EMAIL=facturacion@barbados.com

# NOTAS IMPORTANTES
# - Las claves STRIPE_* y PAYPAL_* pertenecen a la cuenta MERCHANT
#   que recibirá los pagos. Si colocas las claves de otra cuenta,
#   los fondos irán a esa cuenta.
# - En producción configura las variables en el panel del proveedor
#   (Render / Heroku / Vercel / Docker secrets / cloud secrets).
# - Habilita webhooks en Stripe y PayPal y verifica firmas en el
#   backend antes de confirmar pagos en la base de datos.
